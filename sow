#!/usr/bin/env bash
# Shadows of War — single entrypoint & official developer launcher
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

show_help() {
  cat <<'EOF'
Shadows of War — Official Developer CLI & Launcher

USAGE:
  ./sow [COMMAND] [OPTIONS]

COMMANDS:
  (no args)            Fast-build and open the native Electron/WASM game
  m, map                Serve the campaign editor locally on port 8777
  l, local              Build WASM + webroot and serve it locally on port 4173
  native                Fast-build and open the native Electron/WASM game
   p, prod              Run production build & deploy (WASM + FreeBSD backend and relay)
   ptr                  Same deploy as p, for ptr.shadowsofwar.io (PTR, same IONOS host)
   config p|ptr         Edit sow-dist/config/<site>.json (speed, economy, bots) and install it; new matches use it
   a, android           Build the Android AAB and publish it to Google Play alpha
   poki                 Build the self-contained Poki upload folder (no upload/deploy)
   crazygames           Build the self-contained CrazyGames upload folder (no upload/deploy)
   jest                 Build the self-contained Jest bundle + dist/jest.zip (no deploy)
   art-preview [profile] Generate art quality/size previews without credentials or publishing
   help, -h, --help     Show this help message

EXAMPLES:
  ./sow                # Build and open the native desktop client
  ./sow m              # Serve the campaign editor (JSON changes need no Rust rebuild)
  ./sow l              # Build and serve the local web client (Ctrl-C to stop)
  ./sow native         # Build and open the native desktop client
  SOW_NATIVE_RELEASE=1 ./sow  # Compare with optimized WASM in Electron, without an installer
   ./sow p              # Production build and deploy to IONOS
   ./sow p -v           # Production deploy with public version bump
  ./sow p --client-update # Allow a release that locks out store/portal clients until they update
  ./sow p --server-only # Deploy only the FreeBSD game server
  ./sow p --relay-only  # Upgrade the relay control with matches running
  ./sow ptr            # Same pipeline as ./sow p, for ptr.shadowsofwar.io
   ./sow poki           # Build dist/poki for local review and Poki Inspector
   ./sow crazygames     # Build dist/crazygames for private CrazyGames QA
   ./sow jest           # Jest bundle + upload zip (upload via console/MCP, never auto)
   ./sow art-preview ability_icon # Compare distribution quality for all ability icons
  ./sow a              # Android AAB + Play alpha upload (each upload restarts Play review)
EOF
}

CMD="${1:-native}"

load_dist_env() {
  if [[ -f "${ROOT}/sow-dist/.env" ]]; then
    set -a; source "${ROOT}/sow-dist/.env"; set +a
  fi
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
  mkdir -p "${CARGO_TARGET_DIR}"
}

stop_local_preview() {
  local port="${SOW_LOCAL_PORT:-4173}"
  if [[ ! "${port}" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#${port} > 65535 )); then
    return 0
  fi

  local lock="${ROOT}/dist/.sow-state/local-${port}.lock"
  if [[ -f "${lock}" ]]; then
    local pid cwd args pgid
    pid="$(head -n 1 "${lock}" 2>/dev/null || true)"
    if [[ "${pid}" =~ ^[0-9]+$ && -d "/proc/${pid}" ]]; then
      cwd="$(readlink -f "/proc/${pid}/cwd" 2>/dev/null || true)"
      args="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
      if [[ "${cwd}" == "${ROOT}" && ( "${args}" == *"/sow " || "${args}" == *"/sow l"* || "${args}" == *"/sow local"* ) ]]; then
        pgid="$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d ' ')"
        if [[ "${pgid}" == "${pid}" ]]; then
          kill -KILL -- "-${pid}" 2>/dev/null || true
        else
          kill -KILL "${pid}" 2>/dev/null || true
        fi
      fi
    fi
    unlink "${lock}" 2>/dev/null || true
  fi
  fuser -k -KILL "${port}/tcp" >/dev/null 2>&1 || true
}

run_dist_process() {
  local log_prefix="$1"
  local bin="$2"
  shift 2

  cargo build -p sow-dist || return $?
  if [[ "${log_prefix}" == production ]]; then
    command -v flock >/dev/null || { echo "flock is required to prevent overlapping production builds" >&2; return 127; }
    exec flock -n "${ROOT}/dist/.production.lock" "${bin}" "$@"
  elif [[ "${log_prefix}" == ptr ]]; then
    command -v flock >/dev/null || { echo "flock is required to prevent overlapping PTR and production builds" >&2; return 127; }
    # PTR shares dist/ and the IONOS host with production: hold the production lock too.
    exec flock -n "${ROOT}/dist/.production.lock" flock -n "${ROOT}/dist/.ptr.lock" "${bin}" "$@"
  elif [[ "${log_prefix}" == poki ]]; then
    command -v flock >/dev/null || { echo "flock is required to prevent overlapping Poki package builds" >&2; return 127; }
    exec flock -n "${ROOT}/dist/.poki-build.lock" "${bin}" "$@"
  elif [[ "${log_prefix}" == crazygames ]]; then
    command -v flock >/dev/null || { echo "flock is required to prevent overlapping CrazyGames package builds" >&2; return 127; }
    exec flock -n "${ROOT}/dist/.crazygames-build.lock" "${bin}" "$@"
  fi
  exec "${bin}" "$@"
}

production_summary() {
  local log_file="$1"
  local status="$2"
  local site="$3"
  local label published_text unchanged_text stage no_op no_restart release_id diagnostics

  if [[ "${site}" == ptr ]]; then
    label=PTR
    published_text='PTR publicado'
    unchanged_text='PTR ya estaba actualizado; no hubo reinicios'
  else
    label=Production
    published_text='Producción publicada'
    unchanged_text='Producción ya estaba actualizada; no hubo reinicios'
  fi

  if [[ ! -r "${log_file}" ]]; then
    printf '⚠ No se pudo leer el registro: %s\n' "${log_file}"
    return 0
  fi

  if (( status == 0 )); then
    no_op="$(awk -v label="${label}" '$0 == ("✅ " label " already serves the requested content") { found=1 } END { if (found) print "yes" }' "${log_file}" 2>/dev/null || true)"
    no_restart="$(awk '/^  no production component changed; no restart performed$/ { found=1 } END { if (found) print "yes" }' "${log_file}" 2>/dev/null || true)"
    release_id="$(awk -v label="${label}" '$0 ~ ("^✅ " label " .* ready as ") { value=$0; sub(/^.* ready as /, "", value) } END { print value }' "${log_file}" 2>/dev/null || true)"
    if [[ ( "${no_op}" == yes && "${no_restart}" == yes ) || -n "${release_id}" ]]; then
      printf '✅ Pruebas y compilación\n'
      printf '✅ Salud del servidor, relay y verificación pública\n'
      if [[ "${no_op}" == yes && "${no_restart}" == yes ]]; then
        printf '✅ %s\n' "${unchanged_text}"
      else
        printf '✅ %s: %s\n' "${published_text}" "${release_id}"
      fi
    else
      printf '⚠ El proceso terminó con código 0, pero no reconocí el resultado de publicación.\n'
    fi
  else
    stage="$(awk '/^==> [0-9]+\/[0-9]+ / { value=$0 } END { print value }' "${log_file}" 2>/dev/null || true)"
    if [[ -z "${stage}" ]]; then stage='Preparación de sow-dist'; fi
    stage="${stage#==> }"
    printf '❌ Falló %s (código %s)\n' "${stage}" "${status}"
    diagnostics="$(awk '
      /^Caused by:/ {
        lines[++count]=substr($0, 1, 240)
        cause=1
        next
      }
      cause && /^    / {
        lines[++count]=substr($0, 1, 240)
        next
      }
      { cause=0 }
      /^Error:/ || /^error:/ || /^error\[/ || /^fatal:/ || /^not ok / || /^✖ / || /^failures:/ || /^test .* \.\.\. FAILED/ || /^ssh:/ || /^flock:/ || /^curl:/ {
        lines[++count]=substr($0, 1, 240)
      }
      END {
        first=(count > 10 ? count-9 : 1)
        for (i=first; i<=count; i++) print lines[i]
      }
    ' "${log_file}" 2>/dev/null || true)"
    if [[ -z "${diagnostics}" ]]; then
      diagnostics="$(tail -n 10 "${log_file}" 2>/dev/null | awk '/^\+ ssh / { next } { print substr($0, 1, 240) }' || true)"
    fi
    if [[ -n "${diagnostics}" ]]; then
      printf '%s\n' "${diagnostics}"
    else
      printf 'Consulta el registro para ver el error completo.\n'
    fi
    printf 'Registro: %s\n' "${log_file}"
  fi

}

run_dist() {
  local log_prefix="$1"
  shift
  local bin="${CARGO_TARGET_DIR}/debug/sow"
  local log_dir="${ROOT}/dist/logs"
  local log_file="${log_dir}/${log_prefix}-$(date +%Y%m%d-%H%M%S).log"
  local status deploy=false
  case "${log_prefix}" in production|ptr) deploy=true ;; esac
  mkdir -p "${log_dir}"
  : >"${log_file}"
  chmod 600 "${log_file}"
  set +e
  if [[ "${deploy}" == true ]]; then
    printf '⏳ ./sow %s en curso; registro: %s\n' "${CMD}" "${log_file}"
    (run_dist_process "${log_prefix}" "${bin}" "$@") >"${log_file}" 2>&1
    status=$?
  else
    (run_dist_process "${log_prefix}" "${bin}" "$@") 2>&1 | tee "${log_file}"
    status=${PIPESTATUS[0]}
  fi
  set -e
  if [[ "${deploy}" == true ]]; then
    production_summary "${log_file}" "${status}" "${log_prefix}"
  else
    echo "SOW log: ${log_file}"
  fi
  return "${status}"
}

case "${CMD}" in
  -h|--help|help)
    show_help
    exit 0
    ;;
  m|map)
    if [[ -f "${ROOT}/sow-dist/.env" ]]; then
      set -a; source "${ROOT}/sow-dist/.env"; set +a
    fi
    shift || true
    exec bun "${ROOT}/sow-tools/editors/campaign-editor/server.mts" "$@"
    ;;
  l|local)
    if [[ -f "${ROOT}/sow-dist/.env" ]]; then
      set -a; source "${ROOT}/sow-dist/.env"; set +a
    fi
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    stop_local_preview
    BIN="${CARGO_TARGET_DIR}/debug/sow"
    cargo build -p sow-dist
    exec "${BIN}" "$@"
    ;;
  native)
    load_dist_env
    if [[ $# -eq 0 ]]; then
      run_dist native native
    else
      run_dist native "$@"
    fi
    ;;
  p|prod)
    load_dist_env
    run_dist production "$@"
    ;;
  ptr)
    # No load_dist_env: PTR must not inherit production's sow-dist/.env (the binary reads .env.ptr).
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    run_dist ptr "$@"
    ;;
  a|android)
    load_dist_env
    SOW_USER_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
    SOW_RUBY_BIN="${SOW_USER_HOME}/.local/share/gem/ruby/3.4.0/bin"
    export PATH="${SOW_RUBY_BIN}:${PATH}"
    export SOW_PLAY_KEY="${SOW_PLAY_KEY:-${SOW_USER_HOME}/.config/shadows-of-war/google-play-service-account.json}"
    export FASTLANE_OPT_OUT_USAGE=1
    export FASTLANE_SKIP_UPDATE_CHECK=1
    export FASTLANE_DISABLE_COLORS=1
    run_dist android "$@"
    ;;
  jest)
    load_dist_env
    run_dist jest "$@"
    ;;
  poki)
    load_dist_env
    run_dist poki "$@"
    ;;
  crazygames)
    load_dist_env
    run_dist crazygames "$@"
    ;;
  config)
    # Interactive editor: run the binary directly, not through run_dist's log pipe.
    shift || true
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    cargo build -p sow-dist
    exec "${CARGO_TARGET_DIR}/debug/sow" config "$@"
    ;;
  art-preview)
    shift || true
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${ROOT}/target}"
    mkdir -p "${CARGO_TARGET_DIR}"
    BIN="${CARGO_TARGET_DIR}/debug/sow"
    cargo build -p sow-dist
    exec "${BIN}" art-preview "$@"
    ;;
  *)
    echo "Unknown command: ${CMD}" >&2
    echo "" >&2
    show_help >&2
    exit 1
    ;;
esac
