privacy_analytics_body_v2 = "当サイトとブラウザーゲームの任意の自社分析は、許可した後にのみ動作します。ゲームを始めただけでは有効になりません。訪問、読み込み、メニュー、チュートリアル、ロビー、試合開始・終了の限定されたイベントに加え、ビルド、言語、画面サイズの大まかな区分を記録します。端末の完全なフィンガープリントは作成しません。アカウントIDがある場合、保存前にサーバーでこのチャネル専用の鍵付き仮名に置き換えます。名前、メッセージ、パスワード、広告ID、マップのクリックは記録しません。"
privacy_cookies_body_v2 = "分析の選択はローカルストレージに保存します。許可した後にのみ、一時的な分析セッションIDと小さな再送キューをセッションストレージに作成します。拒否してもゲームに影響しません。ゲーム設定、アカウントの継続性、キャッシュ済みリソースには、それぞれの機能に必要な別のストレージを使用します。詳細と設定は"
privacy_retention_body_v2 = "イベントファイル、分析カウンター、関連付け記録は90日以内に期限切れとなります。確認済みのアカウント削除では、関連イベントとアカウント記録を削除します。個人を識別できない日別集計も同じ90日以内に削除されます。アカウントと試合履歴は、削除依頼または規約に基づくアカウント終了まで保持されます。"
privacy_updated_v2 = "最終更新：2026年10月6日 · 管理者：World of Unreal · お問い合わせ：hello@shadowsofwar.io"
cookies_analytics_title = "当サイトとブラウザーゲームの任意の分析"
cookies_analytics_events = "訪問、読み込み段階、メニュー操作、チュートリアルの進行、ロビー参加、試合開始と明示的な退出、画面サイズの大まかな区分を集計します。名前、チャット、パスワード、ロビーID、購入、マップのクリック、完全なユーザーエージェントは記録しません。"
cookies_analytics_server = "許可されたイベントはゲームリレーを経由せず、/api/event の自社エンドポイントに直接送られます。アカウントIDが送信された場合、保存前にこのサイト専用の仮名へ置き換えます。"
cookies_storage_title = "ブラウザー保存と保持期間"
cookies_storage_body = "許可または拒否の選択をローカルに保存します。許可後にのみ、一時的なセッションIDと小さな再送キューをセッションストレージに保存します。分析に含まれるのはビルド、言語、画面サイズの大まかな区分で、完全なユーザーエージェントではありません。イベントと関連付け記録は90日以内に期限切れとなり、確認済みのアカウント削除で関連データを削除します。ゲーム設定、アカウント継続、クラッシュ復旧、キャッシュ済みリソースには必要な別ストレージを使います。"
cookies_platforms_title = "その他のゲームプラットフォーム"
cookies_platforms_body = "Poki、CrazyGames、Jestは各プラットフォームの条件に基づき、それぞれのSDKで利用状況を計測することがあります。これらのプレイヤー単位のイベントを当社サーバーへコピーしません。Androidの自社分析はストアの開示内容を更新するまで無効です。"
cookies_controls_v2 = "任意の分析は、同じように簡単に許可または拒否できます。ゲームを始めても許可したことにはなりません。ゲーム内の設定またはこのページで選択を変更できます。拒否してもプレイに影響しません。サイトデータを消去すると選択も削除され、再度許可するまで分析はオフです。分析データを広告目的で販売・共有することはありません。"
cookies_description_v2 = "任意の製品分析は許可されるまでオフです。ゲームを始めても有効になりません。Shadows of Warが保存するデータと選択の変更方法をご確認ください。"
cookies_og_description_v2 = "任意の分析は許可されるまでオフです。選択はいつでも変更できます。"
