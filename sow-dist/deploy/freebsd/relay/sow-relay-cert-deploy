#!/bin/sh
set -eu

# certbot runs every deploy hook once per renewed lineage. This hook installs
# the relay TLS pair of every SOW site on the host and ignores other lineages.
lineage=${RENEWED_LINEAGE:-/usr/local/etc/letsencrypt/live/shadowsofwar.io}
case "$lineage" in
    /usr/local/etc/letsencrypt/live/shadowsofwar.io)
        host=shadowsofwar.io
        jail=sow-server
        ;;
    /usr/local/etc/letsencrypt/live/ptr.shadowsofwar.io)
        host=ptr.shadowsofwar.io
        jail=ptr-sow-server
        ;;
    *)
        exit 0
        ;;
esac
root=/zroot/jails/$jail/usr/local/etc/sow/relay-tls
gid=$(jexec "$jail" id -g sowrelay)
install -d -o root -g "$gid" -m 0750 "$root"
pair=$(mktemp -d "$root/pair.XXXXXX")
link="$root/.current.$$"
trap 'rm -f "$link"; if [ -n "$pair" ]; then rm -rf "$pair"; fi' EXIT HUP INT TERM
chgrp "$gid" "$pair"
chmod 0750 "$pair"
install -o root -g "$gid" -m 0640 "$lineage/fullchain.pem" "$pair/relay.crt"
install -o root -g "$gid" -m 0640 "$lineage/privkey.pem" "$pair/relay.key"
openssl x509 -in "$pair/relay.crt" -noout -checkhost "$host" | grep -q 'does match'
cert_key=$(openssl x509 -in "$pair/relay.crt" -pubkey -noout)
test "$cert_key" = "$(openssl pkey -in "$pair/relay.key" -pubout)"
old=$(readlink "$root/current" || true)
ln -s "${pair##*/}" "$link"
mv -fh "$link" "$root/current"
pair=
case "$old" in pair.*) rm -rf "$root/$old";; esac
