{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["shell/**/*.ts", "site/auth-callback.ts"],
  "exclude": ["shell/sdk/**/*.ts", "shell/sw.ts"]
}
