    <script type="text/javascript">
        window.SOW_BUILD_TS = "__BUILD_TS__";
        window.SOW_BUILD_VERSION = "__VERSION__";
        window.SOW_MAPS_CACHE_BUST = "__MAPS_CACHE_BUST__";
        /* All endpoints (SOW_WS_URL / SOW_MAPS_URL / SOW_ASSETS_URL /
           SOW_DATABASE_URL) are injected strictly by sow-dist at the
           PORTAL_BOOT_SLOT line below. No defaults and no hostname/referrer
           sniffing: a missing endpoint panics the client instead of
           misrouting (a guessed /api once hit the CrazyGames CDN). */
        /* PORTAL_BOOT_SLOT: SOW_PORTAL / SOW_WS_URL overrides injected by sow-dist crazygames. */

        window.addEventListener('keydown', function (event) {
            if (!window.SOW_NATIVE || event.key !== 'F11') return;
            event.preventDefault();
            var root = document.documentElement;
            if (document.fullscreenElement) {
                if (document.exitFullscreen) document.exitFullscreen().catch(function () {});
            } else if (root.requestFullscreen) {
                root.requestFullscreen().catch(function () {});
            }
        });

    </script>
    <script type="text/javascript">
        window.SOW_show_graphics_error = function () {
            var loader = document.getElementById('web-loader');
            if (!loader) return;
            loader.innerHTML = '';
            loader.style.display = 'grid';
            loader.style.pointerEvents = 'auto';
            loader.setAttribute('aria-busy', 'false');

            var card = document.createElement('div');
            card.className = 'sow-graphics-error';
            var title = document.createElement('h1');
            title.textContent = 'Graphics unavailable';
            var message = document.createElement('p');
            message.textContent = 'This browser or device did not provide a working WebGL2 context.';
            var action = document.createElement('p');
            action.textContent = 'Enable hardware acceleration or use an updated browser, then reload.';
            card.append(title, message, action);
            loader.appendChild(card);
        };

        window.SOW_has_webgl2 = function () {
            var canvas = document.getElementById('blade');
            if (!canvas || typeof window.WebGL2RenderingContext !== 'function') return false;
            try {
                var context = canvas.getContext('webgl2', { antialias: false });
                return !!context
                    && context instanceof window.WebGL2RenderingContext
                    && (!context.isContextLost || !context.isContextLost());
            } catch (error) {
                console.warn('[SOW graphics] WebGL2 preflight failed:', error);
                return false;
            }
        };
    </script>
    <script type="text/javascript">
        /* Crash watchdog: a wasm panic (panic=abort) traps every frame and the
           rAF loop keeps re-entering the poisoned state, freezing the game
           forever while the relay stays healthy. Detect the error storm, keep
           the panic line, and reload once so the auto-reconnect rejoins the
           match instead of leaving a dead tab. */
        (function () {
            var RELOADS_KEY = "SOW_CRASH_RELOADS";
            var PANIC_KEY = "SOW_LAST_PANIC";
            var reloads = 0;
            try { reloads = parseInt(sessionStorage.getItem(RELOADS_KEY) || "0", 10) || 0; } catch (e) {}
            try {
                var prev = sessionStorage.getItem(PANIC_KEY);
                if (prev) {
                    console.warn("[SOW watchdog] previous page crashed; captured panic:", prev);
                    sessionStorage.removeItem(PANIC_KEY);
                }
            } catch (e) {}
            var t0 = Date.now();
            var errs = [];
            window.addEventListener("error", function (ev) {
                errs.push(Date.now());
                if (errs.length > 20) { errs.shift(); }
                var cutoff = Date.now() - 5000;
                var recent = 0;
                for (var i = errs.length - 1; i >= 0 && errs[i] >= cutoff; i--) { recent++; }
                if (recent >= 8 && Date.now() - t0 > 8000 && reloads < 2) {
                    try {
                        sessionStorage.setItem(RELOADS_KEY, String(reloads + 1));
                    } catch (e) {}
                    window.location.reload();
                }
            });
            var origError = console.error;
            console.error = function () {
                for (var i = 0; i < arguments.length; i++) {
                    var a = arguments[i];
                    if (typeof a === "string" && a.indexOf("panicked at") !== -1) {
                        try { sessionStorage.setItem(PANIC_KEY, a); } catch (e) {}
                    }
                }
                return origError.apply(console, arguments);
            };
            setTimeout(function () {
                try { sessionStorage.removeItem(RELOADS_KEY); } catch (e) {}
            }, 600000);
        })();
    </script>
