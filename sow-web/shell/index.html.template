    <script type="module">
        async function run() {
            var isPortal = window.SOW_RUNTIME && window.SOW_RUNTIME.portal_embed === true
                || window.SOW_isPortalEmbed === true;
            var bootDiagnostics = new URLSearchParams(window.location.search).get("diag") === "1";
            function markBoot(name) {
                if (!bootDiagnostics) return;
                performance.mark("sow:boot:" + name);
                console.info("[SOW boot]", name, Math.round(performance.now()) + "ms");
            }
            window.addEventListener("sow:boot-mark", function (event) {
                markBoot(String(event.detail || ""));
            });
            markBoot("startup");

            if (!window.SOW_has_webgl2()) {
                window.SOW_show_graphics_error();
                return;
            }

            // Download and compile the engine, load the glue and restore the
            // identity session while the locale catalog downloads.
            markBoot("wasm-fetch-compile-start");
            const wasmModulePromise = fetch('./__WASM_FILE__').then(function (response) {
                if (!response.ok) throw new Error("WASM request returned " + response.status);
                const streaming = typeof WebAssembly.compileStreaming === "function" &&
                    String(response.headers.get("Content-Type") || "").split(";")[0].trim() === "application/wasm";
                return streaming
                    ? WebAssembly.compileStreaming(response.clone()).catch(function () {
                        return response.arrayBuffer().then(function (bytes) { return WebAssembly.compile(bytes); });
                    })
                    : response.arrayBuffer().then(function (bytes) { return WebAssembly.compile(bytes); });
            }).then(function (module) {
                markBoot("wasm-compiled");
                // Optional gameplay atlases start from the renderer after the campaign map
                // arrives, so they cannot compete with the first match's required assets.
                return { module: module };
            }).catch(function (error) {
                markBoot("wasm-compile-failed");
                return { error: error };
            });
            markBoot("wasm-glue-import-start");
            const wasmGluePromise = import('./__JS_FILE__');
            wasmGluePromise.catch(function () {});
            const identityReady = (async function () {
                /* POKI_IDENTITY_AUTH_BEGIN */
                if (typeof window.SOW_isSowProductionHost === "function" &&
                    window.SOW_isSowProductionHost() &&
                    typeof window.SOW_ensureIdentityAnonymousSession === "function") {
                    try {
                        await Promise.race([
                            window.SOW_ensureIdentityAnonymousSession(),
                            new Promise(function (resolve) { setTimeout(resolve, 5000); }),
                        ]);
                    } catch (error) {
                        // Keep local play available; the SDK retries identity
                        // recovery and online actions wait until it succeeds.
                        // 401/403 is a sign-in state (reauthentication_required), not a fault.
                        const status = Number(error && error.status || 0);
                        if (status !== 401 && status !== 403) {
                            console.warn("Identity session recovery is pending:", error);
                        }
                    }
                }
                /* POKI_IDENTITY_AUTH_END */
            })().then(function () {
                markBoot("identity-ready");
            });

            /* POKI_ANDROID_AUTH_STATE_BEGIN */
            // This only restores cached identity state. It never
            // starts native Play Games authentication before loader-ready.
            if (typeof window.SOW_prepareAndroidAuthState === "function") {
                try {
                    window.SOW_prepareAndroidAuthState();
                } catch (error) {
                    console.error("Play Games authentication failed:", error);
                    // Authentication is best-effort on Android. A failed
                    // handoff must not turn into a black screen; the native
                    // client can continue with its anonymous account.
                    window.SOW_PLATFORM_IDENTITY = null;
                }
            }
            /* POKI_ANDROID_AUTH_STATE_END */

            const portalSdkReady = Promise.resolve().then(function () {
                markBoot("portal-sdk-start");
                if (typeof window.SOW_initPortalSdk === "function") {
                    return window.SOW_initPortalSdk();
                }
            }).then(function () {
                markBoot("portal-sdk-ready");
            });
            // Attach a handler immediately; the original promise is awaited below,
            // while i18n can still be settling in parallel.
            portalSdkReady.catch(function () {});

            try {
                await window.SOW_I18N_READY;
                markBoot("i18n-ready");
                if (typeof window.SOW_refreshWebLoaderText === 'function') {
                    window.SOW_refreshWebLoaderText();
                }
            } catch (error) {
                console.error("[SOW i18n] English catalog could not be loaded:", error);
                return;
            }
            await portalSdkReady;
            await identityReady;
            markBoot("startup-prerequisites-ready");
            if (typeof window.SOW_portalLoadStart === "function") {
                window.SOW_portalLoadStart();
            }
            markBoot("portal-load-start");

            <!-- __SOW_SERVICE_WORKER_SLOT__ -->

            try {
                const wasm = await wasmGluePromise;
                const wasmLoad = await wasmModulePromise;
                if (wasmLoad.error) throw wasmLoad.error;
                markBoot("wasm-init-start");
                await wasm.default({ module_or_path: wasmLoad.module });
                markBoot("wasm-init-ready");
                if (typeof wasm.SOW_wake_event_loop === "function") {
                    window.SOW_wake_event_loop = wasm.SOW_wake_event_loop;
                }
                if (typeof wasm.sow_set_portal_audio_muted === "function") {
                    window.SOW_setPortalAudioMuted = wasm.sow_set_portal_audio_muted;
                    wasm.sow_set_portal_audio_muted(!!(window.SOW_adPlaying || window.SOW_PORTAL_MUTE_AUDIO));
                }
                if (typeof wasm.sow_menu_command === "function") {
                    window.SOW_menu_command = wasm.sow_menu_command;
                    window.SOW_MENU_READY = true;
                    if (typeof window.SOW_flush_menu_commands === "function") {
                        window.SOW_flush_menu_commands();
                    }
                }
            } catch (e) {
                if (e.message !== "Using exceptions for control flow, don't mind me. This isn't actually an error!") {
                    throw e;
                }
            }
        }

        run();
    </script>
</body>
</html>
