{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shadows of War",
  "version": "0.1.0",
  "identifier": "io.shadowsofwar.desktop",
  "build": {
    "frontendDist": "../../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Shadows of War",
        "url": "play/index.html",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
